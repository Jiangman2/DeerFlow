# Build from the repository root. This opt-in path never inherits an old app image.
# Use an approved digest for NODE_IMAGE; frontend_slim.py requires one.
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE} AS dependencies
ARG TARGETARCH
ARG CACHE_SCOPE=deerflow-slim-v1
ARG NPM_REGISTRY=""
WORKDIR /app/frontend
RUN --mount=type=secret,id=enterprise_proxy \
    --mount=type=secret,id=enterprise_ca \
    set -eu; set -a; \
    if [ -s /run/secrets/enterprise_proxy ]; then . /run/secrets/enterprise_proxy; fi; \
    set +a; \
    if [ -s /run/secrets/enterprise_ca ]; then \
      cp /run/secrets/enterprise_ca /etc/ssl/certs/deerflow-enterprise-ca-bundle.crt; \
    else \
      cp /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/deerflow-enterprise-ca-bundle.crt; \
    fi; \
    export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/deerflow-enterprise-ca-bundle.crt; \
    if [ -n "${NPM_REGISTRY}" ]; then export COREPACK_NPM_REGISTRY="$NPM_REGISTRY"; fi; \
    corepack enable; corepack install -g pnpm@10.26.2
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/deerflow-enterprise-ca-bundle.crt
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/.npmrc ./
RUN --mount=type=cache,id=${CACHE_SCOPE}-pnpm-${TARGETARCH},target=/pnpm/store,sharing=locked \
    --mount=type=secret,id=enterprise_proxy \
    set -eu; set -a; \
    if [ -s /run/secrets/enterprise_proxy ]; then . /run/secrets/enterprise_proxy; fi; \
    set +a; \
    pnpm config set store-dir /pnpm/store; \
    if [ -n "${NPM_REGISTRY}" ]; then pnpm config set registry "$NPM_REGISTRY"; fi; \
    pnpm install --frozen-lockfile

FROM dependencies AS compiler
COPY frontend/ ./
ARG APP_VERSION=""
ARG NEXT_PUBLIC_STATIC_WEBSITE_ONLY=""
ARG DEER_FLOW_INTERNAL_GATEWAY_BASE_URL="http://127.0.0.1:8001"
ENV NEXT_PUBLIC_APP_VERSION=$APP_VERSION \
    NEXT_PUBLIC_STATIC_WEBSITE_ONLY=$NEXT_PUBLIC_STATIC_WEBSITE_ONLY \
    DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=$DEER_FLOW_INTERNAL_GATEWAY_BASE_URL \
    NEXT_CONFIG_BUILD_OUTPUT=standalone NEXT_TELEMETRY_DISABLED=1
# Cache only Next's cache, never a previous build's standalone/static output.
# Compilation has no network and no runtime secrets. Type checks remain enabled.
RUN --network=none \
    --mount=type=cache,id=${CACHE_SCOPE}-next-${TARGETARCH},target=/app/frontend/.next/cache,sharing=locked \
    SKIP_ENV_VALIDATION=1 pnpm build
RUN --network=none node scripts/verify-standalone.mjs .next/standalone

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 PORT=3000 \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/deerflow-enterprise-ca-bundle.crt
WORKDIR /app/frontend
COPY --from=dependencies /etc/ssl/certs/deerflow-enterprise-ca-bundle.crt /etc/ssl/certs/deerflow-enterprise-ca-bundle.crt
COPY --from=compiler /app/frontend/.next/standalone/ ./
COPY --from=compiler /app/frontend/.next/static/ ./.next/static/
COPY --from=compiler /app/frontend/public/ ./public/
COPY --from=compiler /app/frontend/scripts/verify-standalone.mjs /opt/deerflow/verify-standalone.mjs
RUN --network=none node /opt/deerflow/verify-standalone.mjs /app/frontend --assets
EXPOSE 3000
CMD ["node", "server.js"]
