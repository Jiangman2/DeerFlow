COPY backend/packages/harness/deerflow/persistence/migrations/versions/0021_oa_result_sets.py /app/backend/packages/harness/deerflow/persistence/migrations/versions/0021_oa_result_sets.py
COPY backend/packages/harness/deerflow/persistence/migrations/versions/0022_work_integration_state.py /app/backend/packages/harness/deerflow/persistence/migrations/versions/0022_work_integration_state.py

RUN cd /app/backend && .venv/bin/python -c "from alembic.config import Config; from alembic.script import ScriptDirectory; from deerflow.persistence import models; from deerflow.persistence.base import Base; c=Config(); c.set_main_option('script_location','packages/harness/deerflow/persistence/migrations'); s=ScriptDirectory.from_config(c); assert s.get_current_head() == '0022_work_integration_state'; assert s.get_revision('0022_work_integration_state').down_revision == '0021_oa_result_sets'; assert 'work_integration_records' in Base.metadata.tables; assert 'result_files' in Base.metadata.tables['oa_policy_flow_jobs'].c"
