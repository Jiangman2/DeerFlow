[Unit]
Description=DeerFlow Frontend (Next.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/deer-flow/frontend
EnvironmentFile=/etc/deerflow/deerflow.env
ExecStart=/usr/bin/env bash -lc 'cd /opt/deer-flow/frontend && if [ -f /opt/deer-flow/frontend/.next/standalone/server.js ]; then HOSTNAME=0.0.0.0 PORT=${FRONTEND_PORT:-3000} node /opt/deer-flow/frontend/.next/standalone/server.js; else PORT=${FRONTEND_PORT:-3000} pnpm start -- --hostname 0.0.0.0 --port ${FRONTEND_PORT:-3000}; fi'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
