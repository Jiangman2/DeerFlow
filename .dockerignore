.env
Dockerfile
.dockerignore
.git
.gitignore
docker/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/

# Web
node_modules
npm-debug.log
.next

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
conf.yaml
web/
docs/
examples/
assets/
tests/
*.log

# Exclude directories not needed in Docker context
# Frontend build only needs frontend/
# Backend build only needs backend/
scripts/
logs/
docker/
skills/
outputs/
.codex-ppt-build/
frontend/.next
frontend/node_modules
backend/.venv
backend/htmlcov
backend/.coverage
backend/config.yaml
backend/extensions_config.json
backend/.deer-flow
backend/.langgraph_api
backend/.pytest_cache
backend/.ruff_cache
*.md
!README.md
!frontend/README.md
!backend/README.md

# Local incremental frontend image (Dockerfile.codex-frontend-live-preview)
!frontend/.next/
!frontend/.next/**
frontend/.next/dev/
frontend/.next/dev/**
frontend/.next/cache/
frontend/.next/cache/**

# Runtime overlay/full builds need these exact service sources. Keep the rest
# of docker/ excluded so unrelated deployment assets do not inflate contexts.
!docker/
docker/*
!docker/sandbox-ppt-master/
docker/sandbox-ppt-master/*
!docker/sandbox-ppt-master/agent_host.py
!docker/provisioner/
docker/provisioner/*
!docker/provisioner/app.py
!docker/mineru_adapter/
docker/mineru_adapter/*
!docker/mineru_adapter/app.py

# The documented Skills seed build copies the complete shipped Skills tree.
# The Sandbox uses a named ppt-master build context, so this rule also keeps the
# root build command functional without depending on ignored source files.
!skills/
!skills/**
