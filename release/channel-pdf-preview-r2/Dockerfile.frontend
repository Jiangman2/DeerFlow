FROM channel-pdf-frontend-base AS source-check
WORKDIR /app/frontend
COPY apply-delta.mjs frontend-delta.json /tmp/channel-pdf-r2/
RUN --network=none node /tmp/channel-pdf-r2/apply-delta.mjs /app/frontend \
    /tmp/channel-pdf-r2/frontend-delta.json /opt/deerflow-release/channel-pdf-r2-frontend.json --check-only

FROM source-check AS candidate
COPY cnooc-haineng-mark.png public/images/cnooc-haineng-mark.png
RUN --network=none node /tmp/channel-pdf-r2/apply-delta.mjs /app/frontend \
      /tmp/channel-pdf-r2/frontend-delta.json /opt/deerflow-release/channel-pdf-r2-frontend.json \
    && SKIP_ENV_VALIDATION=1 NEXT_TELEMETRY_DISABLED=1 NEXT_CONFIG_BUILD_OUTPUT=standalone pnpm build
