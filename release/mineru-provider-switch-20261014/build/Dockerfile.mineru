FROM ppt-relay-mineru-base AS source-check
COPY BUILD-PLAN.json apply_adapter.py source_contract.py candidate_probe.py payload-adapter.py /tmp/mineru-build/
RUN --network=none /app/.venv/bin/python -B /tmp/mineru-build/apply_adapter.py before

FROM source-check AS checked
RUN --network=none /app/.venv/bin/python -B /tmp/mineru-build/apply_adapter.py apply
RUN --network=none /app/.venv/bin/python -B /tmp/mineru-build/candidate_probe.py

FROM ppt-relay-mineru-base AS candidate
COPY --from=checked /app/deerflow_mineru_adapter.py /app/deerflow_mineru_adapter.py
